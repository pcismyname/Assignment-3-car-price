# ---------------------------------------------------------------------------
# Data files (large) — ignored by default, but the course dataset is committed
# so the notebook and CI are fully reproducible without external references.
# ---------------------------------------------------------------------------
*.csv
*.parquet
*.feather
*.h5
*.hdf5
!Cars.csv
!artifacts/cv_results.csv

# ---------------------------------------------------------------------------
# ML artifacts / model files — ignored by default, but the deployed classifier
# bundle is committed so `docker build` in CI has the model it needs to serve.
# ---------------------------------------------------------------------------
*.pkl
*.joblib
*.pt
*.pth
*.onnx
!model/a3_car_price_classifier.pkl
!app/code/a3_car_price_classifier.pkl

# MLflow local tracking store (regenerated by run_a3_experiment.py)
mlflow.db
mlruns/

# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
.env
.env.*
*.env

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
